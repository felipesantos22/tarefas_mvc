@model List<Tarefas.Models.Item>

<h2>Olá, @User.Identity!.Name</h2>

@{
    ViewBag.Title = "Tarefas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">Lista de Tarefas</h1>

            <p class="text-muted mb-0">
                Gerencie suas tarefas cadastradas.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Nova Tarefa
        </a>

    </div>
    
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle mb-1">

                        <thead class="table-dark">
                        <tr>
                            <th>Título</th>
                            <th>Descrição</th>
                            <th class="text-end">Ações</th>
                        </tr>
                        </thead>

                        <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                
                                <td>
                                    <strong>
                                        @item.Titulo
                                    </strong>
                                </td>

                                <td>
                                    @item.Descricao
                                </td>

                                <td class="text-end">


                                    <a asp-action="Detail"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">
                                        Detalhes
                                    </a>


                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>


                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-dark btn-sm"
                                                onclick="return confirm('Deseja realmente excluir esta tarefa?');">
                                            Excluir
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-info text-center">

            <h5>Nenhuma tarefa encontrada</h5>

            <p class="mb-3">
                Você ainda não possui tarefas cadastradas.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                Criar primeira tarefa
            </a>

        </div>
    }

</div>

